# Copy this file to .env for local use. On a real server, set these as environment variables.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Leave empty locally (uses SQLite). In production: postgres://user:pass@host:5432/dbname
DATABASE_URL=
# Optional. If set, the spam limit + alert cooldown use Redis instead of a database table.
REDIS_URL=

# Hidden paths. Change these on the real server.
OWNER_URL_PREFIX=oga
ADMIN_URL_PREFIX=dev-admin

# Max messages per IP per hour
SUBMIT_RATE_LIMIT=5

# Login lockout: wrong passwords allowed, and how long the lock lasts (hours)
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_HOURS=1

# 2-step login (authenticator app) for the oga. False = username + password only.
# Messages stay locked either way: reading them needs his key passphrase (or backup key).
OWNER_2FA=False
# Name shown in the authenticator app (only used when OWNER_2FA=True)
OTP_ISSUER=Suggestion Box

# ---- "New message" alerts (never include message content) ----
ALERT_COOLDOWN_MINUTES=10
# Email:
ALERT_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
# Telegram: make a bot with @BotFather, send it a message, then get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
